<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main glass background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    
    <!-- Drop shadow / Outer bevel -->
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#99000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Base dark smoked glass fill -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <!-- 50% Black -->
            <solid android:color="#80000000" />
            <corners android:radius="32dp" />
            <!-- Darker, subtler outer reflection -->
            <stroke
                android:width="1.5dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Top glossy curve (Simulating strong overhead light) -->
    <item android:bottom="32dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF" />
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp" />
        </shape>
    </item>

    <!-- Bottom inner 3D bevel rim -->
    <item android:top="60dp" android:left="16dp" android:right="16dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>

