<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main glass background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1.2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    
    <!-- Base dark smoked glass fill -->
    <item>
        <shape android:shape="rectangle">
            <!-- 40% Black for a dark, light-absorbing glassy look -->
            <solid android:color="#66000000" />
            <corners android:radius="32dp" />
            <!-- Crisp outer glass reflection -->
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- Top glossy curve (Simulating overhead light reflection) -->
    <item android:bottom="32dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1AFFFFFF" />
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp" />
        </shape>
    </item>

    <!-- Bottom rim light (Light catching the bottom edge) -->
    <item android:top="62dp" android:left="24dp" android:right="24dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
